; Namespace as struct...

; Define a new module to be registered.
(use 
  (let module {
    open: {_: (fn (x,y) ($ "Called open with args %s and %s\n" x y)),
      spec: {
        documentation: "Do an module operation (open)."
        arity: 2
        type: ["string","string"]
        return: ["string"]}
    }   
    close: {_: (fn () ("Called close\n")), spec: {
      documentation: "Do an module operation (close)."
      arity: 0
      type: _
      return: _}
    }
  })
)

(io/write 1 ($ "%s\n" module.open))
(io/write 1 ($ "%s\n" module.close))
(module.open "args1" "args2")
(module.close)

(use "str")
(io/write 1 ($ "%s\n" str))
(io/write 1 (str.lower (module.open "args1" "args2")))
